{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "clientes": {
        "ClusterId": "clientes",
        "Match": { "Path": "/api/clientes/{**catch-all}" }
      },
      "projetos": {
        "ClusterId": "projetos",
        "Match": { "Path": "/api/projetos/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": { "d1": { "Address": "http://auth-service:8080/" } }
      },
      "clientes": {
        "Destinations": { "d1": { "Address": "http://clientes-service:8080/" } }
      },
      "projetos": {
        "Destinations": { "d1": { "Address": "http://projetos-service:8080/" } }
      }
    }
  }
}
